{
  "name": "@egghead/standalone",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --filter=@egghead/web",
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:tsgo": "turbo typecheck:tsgo && tsgo --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "phase0:imports": "tsx --tsconfig apps/web/tsconfig.json scripts/phase0-imports.ts",
    "routing:parity-contract": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/test/routing/route-parity.test.ts apps/web/test/routing/not-found-guards.test.ts apps/web/test/routing/traffic-replay.test.ts",
    "routing:not-found:smoke": "tsx --tsconfig apps/web/tsconfig.json scripts/not-found-status-smoke.ts",
    "routing:v2-contract": "tsx --tsconfig apps/web/tsconfig.json scripts/routing-v2-contract.ts",
    "search:typesense-contract": "tsx --tsconfig apps/web/tsconfig.json scripts/search-typesense-contract.ts",
    "search:typesense-index": "tsx --tsconfig apps/web/tsconfig.json scripts/typesense-index.ts",
    "sitemap:contract": "tsx --tsconfig apps/web/tsconfig.json scripts/sitemap-contract.ts",
    "stripe:subscription-contract": "tsx --tsconfig apps/web/tsconfig.json scripts/stripe-subscription-contract.ts",
    "stripe:webhook-signature-contract": "tsx --tsconfig apps/web/tsconfig.json scripts/stripe-webhook-signature-contract.ts",
    "checkout:customer:smoke": "tsx --tsconfig apps/web/tsconfig.json scripts/checkout-customer-smoke.ts",
    "membership:config:smoke": "tsx --tsconfig apps/web/tsconfig.json scripts/membership-configuration-smoke.ts",
    "profile:contract": "tsx --tsconfig apps/web/tsconfig.json scripts/profile-contract.ts",
    "email:contract": "tsx --tsconfig apps/web/tsconfig.json scripts/email-delivery-contract.ts",
    "auth:linking:contract": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/test/auth/github-account-linking.test.ts",
    "access:delta": "TZ=UTC tsx --tsconfig apps/web/tsconfig.json scripts/access-delta.ts",
    "access:delta:test": "TZ=UTC TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test scripts/access-delta.test.ts",
    "progress:import": "tsx --tsconfig apps/web/tsconfig.json scripts/progress-import.ts",
    "progress:import:rollback": "tsx --tsconfig apps/web/tsconfig.json scripts/progress-import-rollback.ts",
    "progress:import:test": "pnpm --filter @egghead/web exec vitest run src/progress/import.test.ts src/progress/lesson-progress-sources.test.ts",
    "beta:runtime-guard": "tsx --tsconfig apps/web/tsconfig.json scripts/beta-runtime-guard.ts",
    "builder:smoke": "tsx --tsconfig apps/builder-egghead/tsconfig.json scripts/builder-smoke.ts",
    "check": "pnpm typecheck && pnpm typecheck:tsgo && pnpm lint && pnpm format:check && pnpm phase0:imports && pnpm routing:v2-contract && pnpm routing:parity-contract && pnpm workshop:boundaries && pnpm workshop:contract && pnpm workshop:test && pnpm search:typesense-contract && pnpm search:pagination:contract && pnpm sitemap:contract && pnpm stripe:subscription-contract && pnpm stripe:webhook-signature-contract && pnpm checkout:customer:smoke && pnpm membership:config:smoke && pnpm coursebuilder:prices:smoke && pnpm coursebuilder:v3:smoke && pnpm profile:contract && pnpm email:contract && pnpm auth:linking:contract && pnpm access:delta:test && pnpm beta:runtime-guard && pnpm builder:smoke && pnpm workshops:test && pnpm progress:import:test && pnpm --filter @egghead/web exec vitest run src/subscriptions/ownership",
    "hooks:install": "lefthook install",
    "hooks:pre-commit": "lefthook run pre-commit --all-files",
    "coursebuilder:prices:smoke": "node --import tsx scripts/coursebuilder-prices-smoke.ts",
    "coursebuilder:v3:smoke": "node --import tsx scripts/coursebuilder-v3-smoke.ts",
    "membership:setup": "EGGHEAD_LOCAL_MEMBERSHIP=true node --env-file=apps/web/.env --import tsx scripts/local-membership-setup.ts",
    "membership:dev": "EGGHEAD_LOCAL_MEMBERSHIP=true pnpm --filter @egghead/web dev --hostname 127.0.0.1",
    "workshop:contract": "tsx --tsconfig apps/web/tsconfig.json scripts/workshop-contract.ts",
    "workshops": "tsx --tsconfig apps/web/tsconfig.json scripts/workshops.ts",
    "workshop:boundaries": "tsx scripts/workshop-boundaries.ts",
    "workshop:test": "vitest run packages/workshops/test packages/workshop-catalog/test",
    "test": "pnpm workshop:test",
    "workshop:mysql-test": "vitest run packages/workshop-catalog/integration/mysql.test.ts",
    "workshops:test": "pnpm --filter @egghead/builder typecheck:workshops && pnpm --filter @egghead/core test && pnpm --filter @egghead/builder test && pnpm workshops:preview:contract && pnpm workshops:checkout:contract",
    "workshops:preview:contract": "tsx --tsconfig apps/web/tsconfig.json scripts/workshop-preview-contract.ts",
    "workshops:checkout:contract": "tsx --tsconfig apps/web/tsconfig.json scripts/workshop-checkout-contract.ts",
    "search:pagination:contract": "node --experimental-test-module-mocks --import tsx --test scripts/search-pagination.test.ts scripts/search-readers.test.ts scripts/readiness-regression/search-fallback.test.ts",
    "search:pagination:smoke": "tsx --tsconfig apps/web/tsconfig.json scripts/search-pagination-smoke.ts",
    "routing:redirect-targets": "tsx --tsconfig apps/web/tsconfig.json scripts/redirect-targets-check.ts"
  },
  "dependencies": {
    "@coursebuilder/adapter-drizzle": "3.1.3",
    "@coursebuilder/commerce": "0.2.3",
    "@coursebuilder/core": "3.1.2",
    "@coursebuilder/email": "0.1.6",
    "@coursebuilder/next": "0.0.42",
    "@coursebuilder/server": "0.2.3",
    "@coursebuilder/ui": "2.5.5",
    "@coursebuilder/utils": "1.1.6",
    "@coursebuilder/video-processing": "0.1.6"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@egghead/workshop-catalog": "workspace:*",
    "@egghead/workshops": "workspace:*",
    "@total-typescript/tsconfig": "1.0.4",
    "@types/node": "^20.19.25",
    "@typescript/native-preview": "7.0.0-dev.20260607.1",
    "drizzle-orm": "0.36.0",
    "effect": "4.0.0",
    "lefthook": "2.1.9",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "oxlint-tsgolint": "0.23.0",
    "tsx": "^4.21.0",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "vitest": "5.0.0",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.3.0"
}
