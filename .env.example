NEXT_PUBLIC_APP_NAME=egghead
NEXT_PUBLIC_APP_URL=http://localhost:3008
COURSEBUILDER_URL=http://localhost:3008/api/coursebuilder
DATABASE_URL=mysql://root:root@127.0.0.1:3307/coursebuilder_test
EGGHEAD_RUNTIME=local
EGGHEAD_BETA_DB_APPROVED=false
AUTH_SECRET=local-dev-only-change-me
NEXT_PUBLIC_SITE_TITLE=egghead
CREATE_USER_ON_LOGIN=true
SEND_EMAILS=false
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL="egghead <team@egghead.io>"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_TOKEN=
STRIPE_WEBHOOK_SECRET=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Canonical readers use the stable alias after it has been provisioned and verified.
TYPESENSE_COLLECTION_NAME=egghead_content
NEXT_PUBLIC_TYPESENSE_COLLECTION_NAME=egghead_content
NEXT_PUBLIC_TYPESENSE_HOST=
NEXT_PUBLIC_TYPESENSE_HOST_HASH=
NEXT_PUBLIC_TYPESENSE_PORT=443
NEXT_PUBLIC_TYPESENSE_PROTOCOL=https
# Search-only key, scoped to the alias and versioned migration collections.
NEXT_PUBLIC_TYPESENSE_API_KEY=
# Operator-only; never add the write key to a public variable or browser bundle.
TYPESENSE_WRITE_API_KEY=
EGGHEAD_TYPESENSE_INDEX_APPROVED=false
# Operator assertion after an actual content-write freeze; not a runtime lock.
EGGHEAD_CONTENT_WRITES_PAUSED=false

# Operator-only Rails attribution repair: strict TLS and a read-only Rails session.
EGGHEAD_POSTGRES_DATABASE_URL=
EGGHEAD_RAILS_CA_FILE=
EGGHEAD_CONTRIBUTION_BACKFILL_APPROVED=false
